# Copy to .env and edit as needed. Every value here has a working default.

# Local SQLite (default). For Postgres use:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./jal24x7.db

# Sign your own secret in production: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-jal24x7

# true  = OTP is shown on screen, no SMS gateway needed (demo / viva)
# false = OTP is only logged; wire up MSG91 or Twilio in routers/auth.py
DEMO_MODE=true

# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set false only when running the test suite.
RATE_LIMIT_ENABLED=true
